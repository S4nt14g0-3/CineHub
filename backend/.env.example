# ============================================================
# Variables de entorno del backend (plantilla).
# Copiar este archivo a backend/.env y completar con valores reales.
# ============================================================

# Puerto del servidor Express
PORT=5000

# Cadena de conexión a PostgreSQL (Neon). Ejemplo:
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# Clave secreta para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura

# ------------------------------------------------------------
# QUÉ SABER DE ESTE ARCHIVO
# - Este archivo SÍ se sube a git (es solo una plantilla).
# - El archivo real es backend/.env y está en .gitignore.
# - dotenv interpreta como comentario las líneas que inician con '#'.
# ------------------------------------------------------------

# ============================================================
# Variables de entorno del frontend (plantilla).
# Copiar a frontend/.env.local para desarrollo.
# ============================================================

# URL base de la API del backend (debe terminar en /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------
# QUÉ SABER DE ESTE ARCHIVO
# - Si no se define, la app usa http://localhost:5000/api por defecto.
# - El archivo real es frontend/.env.local y está en .gitignore.
# ------------------------------------------------------------
